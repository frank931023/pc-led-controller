# ── PC 端控制中心設定 ────────────────────────────────────────
#
# 用法：
#   cp .env.example .env
#   docker compose up -d
#
# 通常不需要改任何值，直接複製即可。


# 控制中心的網頁 / API 連接埠，開瀏覽器就是連這個
HOST_PORT=5001


# 裝置清單存放位置（容器內路徑）。
# 對應到宿主機的 ./data 目錄，容器重建也不會遺失。
CONFIG_FILE=/app/data/pi_config.json


# Flask debug 模式。
# 保持 0！設成 1 會把 Werkzeug debugger 開放給整個區域網路，
# 任何人都能透過瀏覽器在這台 PC 上執行程式碼。
FLASK_DEBUG=0
