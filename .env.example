# ── Motion Control Center（PC 端）設定 ────────────────────────────────────────
#
# 用法：
#   cp .env.example .env
#   docker compose up -d
#
# 通常不需要改任何值，直接複製即可。


# 控制中心的網頁 / API 連接埠，開瀏覽器就是連這個
HOST_PORT=5001


# 裝置清單存放位置（容器內路徑）。
# 對應到宿主機的 ./data 目錄，容器重建也不會遺失。
CONFIG_FILE=/app/data/pi_config.json


# Flask debug 模式。
# 保持 0！設成 1 會把 Werkzeug debugger 開放給整個區域網路，
# 任何人都能透過瀏覽器在這台 PC 上執行程式碼。
FLASK_DEBUG=0


# 選填。設定後，所有會改變東西的 API（送指令、新增/刪除裝置…）都要帶
#   Authorization: Bearer <API_TOKEN>
# 網頁第一次操作時會要求輸入一次並記在瀏覽器裡；Ansible 用 group_vars 的 pc_api_token。
# 留空 = 不需要驗證（只在受信任的區網使用）。
API_TOKEN=


# 指令逾時（秒）。每台 Pi 會在 /api/status 回報自己的 COMMAND_TIMEOUT / MAX_COMMAND_TIMEOUT，
# 以 Pi 的為準；這兩個只在還沒成功檢測過那台 Pi 時使用。
DEFAULT_COMMAND_TIMEOUT=130
MAX_COMMAND_TIMEOUT=300


# Docker 內部網路的子網段。只有跟實體 LAN 撞網段（容器連不到 Pi，出現 No route to host）時才需要改。
DOCKER_SUBNET=192.168.250.0/24


# ── Pi 健康監控（Beszel）────────────────────────────────────
# Beszel hub 跟控制中心一起啟動。這組帳密會在 hub 第一次啟動時建立管理員，
# 控制中心也用它讀取各台 Pi 的 CPU / 記憶體 / 溫度。
# ⚠ 第一次啟動後再改這裡不會改到既有帳號（見 README「Pi 健康監控」）。
BESZEL_EMAIL=admin@gmail.com
BESZEL_PASSWORD=admin

# Beszel 網頁的連接埠，開 http://<這台 PC 的 IP>:8090 就是 Beszel
BESZEL_PORT=8090

# 選填。Pi 與瀏覽器連到 hub 的網址，例如 http://172.18.177.10:8090。
# 留空 = 自動用你開控制中心網頁時的那個主機位址。
BESZEL_PUBLIC_URL=
