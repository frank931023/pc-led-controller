# Managed by Ansible (pc-led-controller/deploy/ansible). Local edits are overwritten on the next run;
# change inventory.yml / group_vars instead.
PI_ID={{ pi_id }}
SERIAL_PORT={{ pi_serial_port }}
BAUD_RATE={{ baud_rate }}
HOST_PORT={{ pi_port }}
COMMAND_TIMEOUT={{ command_timeout }}
MAX_COMMAND_TIMEOUT={{ max_command_timeout }}
{% if pi_image %}
PI_IMAGE={{ pi_image }}
{% else %}
APP_VERSION={{ pi_repo_version }}@{{ checkout.after[:7] }}
{% endif %}
{% if monitoring | bool %}

COMPOSE_PROFILES=monitoring
BESZEL_HUB_URL={{ agent_env.json.hub_url }}
BESZEL_KEY="{{ agent_env.json.key }}"
BESZEL_TOKEN={{ agent_env.json.token }}
{% endif %}
